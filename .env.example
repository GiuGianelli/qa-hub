ZEPHYR_TOKEN=your_zephyr_token_here
JIRA_PROJECT=DEV
TEST_CASES_FILE=test-cases.json
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token_here
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here
CONFLUENCE_BDD_PAGE_ID=your_confluence_page_id_here
CONFLUENCE_QA_NOTES_URL=https://yourcompany.atlassian.net/wiki/spaces/Engineering/pages/your_page_id/QA+Validation+Playbook
CONFLUENCE_GHERKIN_URL=https://yourcompany.atlassian.net/wiki/spaces/Engineering/pages/your_page_id/Gherkin+Standards+for+Acceptance+Tests
# Branch Analysis — pick one of the two options below:
# Option A: local git repos (no GitHub MCP needed)
REPOS_BASE_DIR=/Users/you/your-repos-folder
# Option B: GitHub MCP (requires ~/.claude/mcp.json with github configured)
GITHUB_ORG=your-github-org
# Optional: required for Feature Writer S3 sync
FEATURE_STORE_S3_BUCKET=s3://your-feature-store-bucket